# Copy to frontend/.env.local for local runtime. See docs/credentials.md.
# Production values belong in Vercel; preserve the existing production settings.
# Leave database URLs blank for the local read-only preview.
# Otherwise use a Neon development branch: pooled DATABASE_URL, direct DIRECT_URL.
DATABASE_URL=""
DIRECT_URL=""
NEXTAUTH_URL="http://localhost:3000"
# Generate a LOCAL secret using: openssl rand -base64 32
NEXTAUTH_SECRET=""

# NEXT ITERATION ONLY: Google for both members and administrators.
# Reserved names; the current code does not register a Google provider yet.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OPTIONAL existing providers. Leave blank for this release.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# CLI ONLY: also set in backend/.env when deliberately bootstrapping moderators.
# Comma-separated emails; defer until Google login is implemented and tested.
MODERATOR_EMAILS=""

# No map/geolocation API key is required by the current application.
