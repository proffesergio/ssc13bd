# Prisma/seed CLI only: copy to backend/.env. See docs/credentials.md.
# Runtime settings go in frontend/.env.local locally and Vercel in production.
# Use a development Neon branch locally. Never commit real connection strings.
# DATABASE_URL: pooled hostname (-pooler), sslmode=require,
#               connection_limit=1 and pool_timeout=10.
# DIRECT_URL: direct hostname, sslmode=require, same branch/database/role.
DATABASE_URL=""
DIRECT_URL=""

# CLI ONLY. Sign in first, then deliberately promote trusted existing accounts.
# Defer until Google login is implemented; this grants MODERATOR, not ADMIN.
MODERATOR_EMAILS=""
