# Copy values into frontend/.env.local for Next.js runtime, and backend/.env for Prisma CLI.
# Neon pooled URL for runtime (contains -pooler); direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/ssc13bd?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/ssc13bd?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-bytes"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-me"
SMTP_PASSWORD="replace-me"
SMTP_FROM="SSC13BD <hello@example.com>"
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Used only by the deliberate moderator bootstrap seed. Existing role changes require rerunning it.
MODERATOR_EMAILS="moderator@example.com"
